# Optional Supabase Cloud Configuration
# If omitted, COSMOS runs in Local Full-Stack Mode with its built-in Node + SQLite server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local Backend Server Configuration
PORT=4000
COSMOS_JWT_SECRET=cosmos-event-horizon-dev-secret-change-in-prod
COSMOS_DB_PATH=./server/cosmos.db
